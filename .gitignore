node_modules/
.next/
__pycache__/
*.py[cod]
.venv/
*.db
.pytest_cache/
*.tsbuildinfo

# Every environment file, in every form the tooling reads. Next.js also loads
# .env.local / .env.<mode>.local, which a bare ".env" rule would not have
# covered -- only the committed examples are tracked.
.env
.env.*
!.env.example

# Generated by `next dev` on every run (disable with agentRules: false).
AGENTS.md
frontend/CLAUDE.md

# Reproducible ML experiment outputs (regenerate with ai-lab/experiments/*)
ai-lab/datasets/*.jsonl
ai-lab/evaluation/*.json
ai-lab/models/*.joblib
