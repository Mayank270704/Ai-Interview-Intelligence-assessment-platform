# Supabase PostgreSQL connection used by SQLAlchemy and Alembic.
# Direct connection: db.<project-ref>.supabase.co:5432
# Session pooler:    aws-0-<region>.pooler.supabase.com:5432 (user postgres.<project-ref>)
# Run migrations against a direct or session-pooler URL, not the transaction pooler.
DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional PostgreSQL database used by the persistence smoke test. Never point this
# at the database that holds real interview data.
TEST_DATABASE_URL=

# LLM provider used for question generation, answer analysis, and evaluation.
# ATS scoring is deterministic and never calls an LLM.
LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# Voice interview (speech-to-text and text-to-speech).
# Speech-to-text reuses GEMINI_MODEL; text-to-speech needs an audio-output model.
VOICE_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Supabase Storage, used to store the original uploaded resume PDFs in a private bucket.
# SUPABASE_URL is the project's REST endpoint: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY must be the service-role key (server-side only, never sent
# to the frontend) so uploads can write to a private, non-public bucket.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_RESUME_BUCKET=resumes

# Supabase Auth. The anon key is the public client key used to call GoTrue for
# signup, login, and token verification. It is NOT the service-role key.
SUPABASE_ANON_KEY=<anon-key>

# Browser origins allowed to call this API, comma-separated. Set this explicitly
# in every deployment; the default only covers local frontend development.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application name shown in the OpenAPI docs.
APP_NAME=AI Interview Intelligence API
